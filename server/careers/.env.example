# Example names only. Put real values in your hosting secret manager, never GitHub or browser code.
CAREERS_ENABLED=false
CAREERS_PRIVACY_APPROVED=false
CAREERS_ALLOWED_ORIGINS=https://www.aloden.com
CAREERS_APPLICANT_NOTICE_URL=
CAREERS_TURNSTILE_SITE_KEY=
CAREERS_TURNSTILE_SECRET=
CAREERS_STATE_DB=/var/lib/aloden-private/careers.sqlite
CAREERS_RATE_SALT=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=
CAREERS_CLAM_HOST=127.0.0.1
CAREERS_CLAM_PORT=3310
CAREERS_BIND_HOST=127.0.0.1
CAREERS_PORT=8788
# Empty means do NOT trust any forwarding headers. Exact private proxy IPs only.
CAREERS_TRUSTED_PROXY_IPS=

# Jobs publishing is separate from resume delivery; both remain off until deployment.
CAREERS_JOBS_ENABLED=false
CAREERS_JOBS_DB=/var/lib/aloden-private/jobs.sqlite
CAREERS_SITE_ORIGIN=https://www.aloden.com
CAREERS_HR_ENABLED=false
# Website-owned OAuth client for openid/email sign-in, separate from Gmail sending.
CAREERS_HR_CLIENT_ID=
CAREERS_HR_CLIENT_SECRET=
# Exact lowercase account emails only, assigned editor or publisher. No defaults.
CAREERS_HR_USERS_JSON={}
